# AI chat provider — set at least ONE of these in Vercel → Settings → Environment Variables.
# Anthropic is used first when both are present.

# Anthropic (recommended). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=
# Optional: only for an API gateway/proxy that speaks the Messages API.
ANTHROPIC_BASE_URL=

# Google Gemini fallback. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=
# Optional: only for a proxy/gateway that speaks the Gemini API.
GEMINI_BASE_URL=
